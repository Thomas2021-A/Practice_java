        input:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15); }
        
        .hint { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
        .field-error { color: #dc2626; font-size: 0.825rem; margin-top: 0.35rem; display: block; font-weight: 500; }
        
        .btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: 0.75rem 1rem; font-size: 1rem; font-weight: 600; border-radius: 0.5rem; border: none; cursor: pointer; text-decoration: none; background: var(--primary); color: white; transition: background 0.2s; margin-top: 0.5rem; }
