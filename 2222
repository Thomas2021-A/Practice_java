        .auth-container { flex: 1; display: flex; justify-content: center; align-items: center; padding: 2.5rem 1rem; }
        .auth-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 0.75rem; width: 100%; max-width: 420px; padding: 2.25rem; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08); }
